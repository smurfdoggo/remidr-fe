      "html": "<nav class=\"ds-nav\" aria-label=\"Destinations\"><span aria-current=\"page\">Dashboard</span><span>Explore</span></nav>",
      "css": ".ds-nav{display:flex;justify-content:space-around;background:hsl(var(--background));color:hsl(var(--foreground));padding:16px;gap:24px;font-family:system-ui,sans-serif}.ds-nav [aria-current]{color:hsl(var(--primary));background:hsl(var(--secondary))}"
